:root {
  color-scheme: dark;
  --accent: #6366f1;
  --accent-contrast: #ffffff;
  --accent-text: #818cf8;
  --accent-amber: #f59e0b;
  --accent-emerald: #10b981;
  --accent-rose: #f43f5e;
  --bg-darker: #07090e;
  --bg: #0b0f17;
  --surface: #111827;
  --surface-glass: rgba(17, 24, 39, 0.75);
  --card-bg: #111827;
  --card-border: rgba(255, 255, 255, 0.07);
  --card-hover: #1f2937;
  --text: #f3f4f6;
  --text-muted: #9ca3af;
  --border: rgba(255, 255, 255, 0.08);
  --radius: 12px;
  --shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.5), 0 4px 6px -2px rgba(0, 0, 0, 0.3);
  --space: 16px;
}

* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; scroll-behavior: smooth; }
body {
  background: var(--bg-darker);
  background-image: 
    radial-gradient(circle at 10% 10%, rgba(99, 102, 241, 0.06) 0%, transparent 40%),
    radial-gradient(circle at 90% 90%, rgba(16, 185, 129, 0.04) 0%, transparent 40%);
  color: var(--text);
  font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

::-webkit-scrollbar { width: 6px; height: 6px; }
::-webkit-scrollbar-track { background: var(--bg); }
::-webkit-scrollbar-thumb { background: #374151; border-radius: 3px; }
::-webkit-scrollbar-thumb:hover { background: #4b5563; }

.delta-header {
  background: var(--surface-glass);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border);
  padding: 0.9rem 1.75rem;
  position: sticky;
  top: 0;
  z-index: 50;
}
.header-content {
  max-width: 1440px;
  margin: 0 auto;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 1.25rem;
}
.brand-group {
  display: flex;
  align-items: center;
  gap: 1rem;
}
.brand-badge {
  background: linear-gradient(135deg, #6366f1 0%, #4338ca 100%);
  color: #fff;
  font-weight: 800;
  padding: 0.4rem 0.8rem;
  border-radius: 10px;
  letter-spacing: 0.08em;
  font-size: 0.95rem;
  box-shadow: 0 0 20px rgba(99, 102, 241, 0.35);
  border: 1px solid rgba(255, 255, 255, 0.15);
}
.brand-titles h1 {
  font-size: 1.15rem;
  font-weight: 700;
  margin: 0;
  color: #ffffff;
  letter-spacing: -0.01em;
}
.brand-titles p {
  font-size: 0.78rem;
  margin: 0;
  color: var(--text-muted);
}
.header-meta {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  flex-wrap: wrap;
}
.meta-tag {
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid var(--border);
  padding: 0.3rem 0.75rem;
  border-radius: 8px;
  font-size: 0.78rem;
  color: #d1d5db;
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  font-weight: 500;
}
.status-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background-color: var(--accent-emerald);
  box-shadow: 0 0 10px var(--accent-emerald);
  animation: pulse-glow 2s infinite;
}
@keyframes pulse-glow {
  0% { transform: scale(0.95); opacity: 0.8; }
  50% { transform: scale(1.1); opacity: 1; box-shadow: 0 0 14px var(--accent-emerald); }
  100% { transform: scale(0.95); opacity: 0.8; }
}

.gemini-alert {
  background: linear-gradient(90deg, rgba(245, 158, 11, 0.08), rgba(245, 158, 11, 0.15));
  border-bottom: 1px solid rgba(245, 158, 11, 0.25);
  color: #fde047;
  padding: 0.6rem 1.75rem;
  font-size: 0.82rem;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 1.25rem;
  flex-wrap: wrap;
  font-weight: 500;
}

.tabs-nav-container {
  background: rgba(11, 15, 23, 0.8);
  border-bottom: 1px solid var(--border);
  padding: 0 1.75rem;
  backdrop-filter: blur(8px);
}
.tabs-nav {
  max-width: 1440px;
  margin: 0 auto;
  display: flex;
  gap: 0.35rem;
  overflow-x: auto;
}
.tab-button {
  background: transparent;
  border: none;
  border-bottom: 2px solid transparent;
  color: var(--text-muted);
  font-size: 0.86rem;
  font-weight: 600;
  padding: 0.95rem 1.15rem;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 0.55rem;
  white-space: nowrap;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  border-radius: 8px 8px 0 0;
}
.tab-button:hover {
  color: #f3f4f6;
  background: rgba(255, 255, 255, 0.02);
}
.tab-button.active {
  color: #818cf8;
  border-bottom-color: #6366f1;
  background: rgba(99, 102, 241, 0.06);
}

.delta-main {
  max-width: 1440px;
  margin: 0 auto;
  padding: 1.75rem;
  flex: 1;
  width: 100%;
}

.action-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 0.85rem;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1.35rem;
}
.action-group {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
  align-items: center;
}

.btn-delta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 0.55rem 1rem;
  font-size: 0.84rem;
  font-weight: 600;
  border-radius: 9px;
  border: 1px solid transparent;
  cursor: pointer;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  text-decoration: none;
  line-height: 1.25;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
}
.btn-delta:active { transform: translateY(1px); }
.btn-indigo {
  background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
  color: #ffffff;
  border-color: rgba(255, 255, 255, 0.15);
  box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
}
.btn-indigo:hover {
  background: linear-gradient(135deg, #4f46e5 0%, #4338ca 100%);
  box-shadow: 0 6px 16px rgba(99, 102, 241, 0.4);
}
.btn-emerald {
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  color: #ffffff;
  border-color: rgba(255, 255, 255, 0.15);
  box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
}
.btn-emerald:hover {
  background: linear-gradient(135deg, #059669 0%, #047857 100%);
}
.btn-amber {
  background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
  color: #ffffff;
  border-color: rgba(255, 255, 255, 0.15);
}
.btn-amber:hover {
  background: linear-gradient(135deg, #d97706 0%, #b45309 100%);
}
.btn-slate {
  background: #1f2937;
  color: #e5e7eb;
  border-color: var(--border);
}
.btn-slate:hover {
  background: #374151;
  color: #ffffff;
  border-color: rgba(255, 255, 255, 0.15);
}
.btn-danger {
  background: rgba(239, 68, 68, 0.15);
  color: #fca5a5;
  border-color: rgba(239, 68, 68, 0.3);
}
.btn-danger:hover {
  background: rgba(239, 68, 68, 0.25);
  color: #fee2e2;
  border-color: rgba(239, 68, 68, 0.5);
}
.btn-sm {
  padding: 0.35rem 0.7rem;
  font-size: 0.78rem;
  border-radius: 7px;
}

.filters-box {
  background: var(--card-bg);
  border: 1px solid var(--card-border);
  border-radius: var(--radius);
  padding: 1.25rem;
  margin-bottom: 1.35rem;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
  gap: 0.85rem;
  align-items: flex-end;
  box-shadow: var(--shadow);
}
.form-group {
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
}
.form-group label {
  font-size: 0.74rem;
  font-weight: 700;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}
.input-delta, select.input-delta {
  background: rgba(11, 15, 23, 0.6);
  border: 1px solid var(--border);
  color: var(--text);
  padding: 0.5rem 0.75rem;
  border-radius: 8px;
  font-size: 0.84rem;
  outline: none;
  transition: all 0.2s ease;
  width: 100%;
  box-sizing: border-box;
}
.input-delta:focus {
  border-color: #6366f1;
  box-shadow: 0 0 0 2px rgba(99, 102, 241, 0.25);
  background: rgba(11, 15, 23, 0.9);
}

.table-info-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 0.75rem;
  font-size: 0.82rem;
  color: var(--text-muted);
}

.table-card {
  background: var(--card-bg);
  border: 1px solid var(--card-border);
  border-radius: var(--radius);
  overflow: hidden;
  box-shadow: var(--shadow);
}
.table-scroll {
  overflow-x: auto;
  max-width: 100%;
}
.delta-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.83rem;
  text-align: left;
}
.delta-table th {
  background: rgba(17, 24, 39, 0.95);
  color: var(--text-muted);
  font-weight: 700;
  padding: 0.85rem 1rem;
  border-bottom: 1px solid var(--border);
  text-transform: uppercase;
  font-size: 0.72rem;
  letter-spacing: 0.06em;
  white-space: nowrap;
}
.delta-table td {
  padding: 0.75rem 1rem;
  border-bottom: 1px solid rgba(255, 255, 255, 0.04);
  color: #e5e7eb;
  vertical-align: middle;
}
.delta-table tbody tr {
  transition: background-color 0.15s ease;
}
.delta-table tbody tr:hover {
  background-color: var(--card-hover);
}
.delta-table tr.selected-row {
  background-color: rgba(99, 102, 241, 0.12) !important;
}

.badge-status {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  padding: 0.25rem 0.65rem;
  border-radius: 9999px;
  font-size: 0.72rem;
  font-weight: 700;
  white-space: nowrap;
  letter-spacing: 0.02em;
}
.status-entregue {
  background: rgba(16, 185, 129, 0.12);
  color: #34d399;
  border: 1px solid rgba(16, 185, 129, 0.3);
}
.status-andamento {
  background: rgba(59, 130, 246, 0.12);
  color: #60a5fa;
  border: 1px solid rgba(59, 130, 246, 0.3);
}
.status-aguardando {
  background: rgba(245, 158, 11, 0.12);
  color: #fbbf24;
  border: 1px solid rgba(245, 158, 11, 0.3);
}
.status-atrasado {
  background: rgba(239, 68, 68, 0.12);
  color: #f87171;
  border: 1px solid rgba(239, 68, 68, 0.3);
}

.pill-linha {
  display: inline-block;
  padding: 0.2rem 0.5rem;
  border-radius: 6px;
  font-size: 0.7rem;
  font-weight: 700;
  background: rgba(255, 255, 255, 0.04);
  color: var(--text-muted);
  border: 1px solid rgba(255, 255, 255, 0.06);
  text-transform: uppercase;
}
.pill-linha.pesada {
  border-color: rgba(129, 140, 248, 0.3);
  color: #c7d2fe;
  background: rgba(99, 102, 241, 0.12);
}

.kpi-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 1.25rem;
  margin-bottom: 1.75rem;
}
.kpi-card {
  background: var(--card-bg);
  border: 1px solid var(--card-border);
  border-radius: var(--radius);
  padding: 1.35rem 1.5rem;
  position: relative;
  overflow: hidden;
  box-shadow: var(--shadow);
  transition: transform 0.2s ease, border-color 0.2s ease;
}
.kpi-card:hover {
  transform: translateY(-2px);
  border-color: rgba(255, 255, 255, 0.15);
}
.kpi-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 4px;
  height: 100%;
  background: var(--accent);
}
.kpi-card.green::before { background: var(--accent-emerald); }
.kpi-card.amber::before { background: var(--accent-amber); }
.kpi-card.blue::before { background: #3b82f6; }

.kpi-title {
  font-size: 0.75rem;
  color: var(--text-muted);
  text-transform: uppercase;
  font-weight: 700;
  letter-spacing: 0.06em;
  margin-bottom: 0.5rem;
}
.kpi-num {
  font-size: 2rem;
  font-weight: 800;
  color: #ffffff;
  line-height: 1.1;
  letter-spacing: -0.02em;
}
.kpi-sub {
  font-size: 0.76rem;
  color: var(--text-muted);
  margin-top: 0.5rem;
}

.dash-sections-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.5rem;
}
@media (max-width: 1024px) {
  .dash-sections-grid {
    grid-template-columns: 1fr;
  }
}

.teams-production-card {
  background: var(--card-bg);
  border: 1px solid var(--card-border);
  border-radius: var(--radius);
  padding: 1.5rem;
  box-shadow: var(--shadow);
}

.team-item {
  background: rgba(11, 15, 23, 0.5);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 1rem;
  margin-bottom: 0.85rem;
  transition: background 0.15s ease;
}
.team-item:hover {
  background: rgba(11, 15, 23, 0.8);
}

.podium-container {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 1.5rem;
  margin: 2.5rem 0 2rem;
  padding: 1rem 0;
}
.podium-step {
  text-align: center;
  width: 220px;
}
.podium-pillar {
  background: linear-gradient(180deg, rgba(31, 41, 55, 0.8) 0%, rgba(17, 24, 39, 0.95) 100%);
  border: 1px solid var(--border);
  border-radius: 14px 14px 0 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 1.75rem 0.5rem;
  box-shadow: 0 15px 35px rgba(0,0,0,0.4);
  position: relative;
  overflow: hidden;
}
.step-1 .podium-pillar { height: 190px; border-color: rgba(245, 158, 11, 0.5); background: linear-gradient(180deg, rgba(43, 34, 16, 0.9) 0%, rgba(17, 24, 39, 0.95) 100%); }
.step-2 .podium-pillar { height: 145px; border-color: rgba(156, 163, 175, 0.4); }
.step-3 .podium-pillar { height: 115px; border-color: rgba(180, 83, 9, 0.4); }
.medal-icon {
  font-size: 2.25rem;
  margin-bottom: 0.5rem;
  filter: drop-shadow(0 4px 8px rgba(0,0,0,0.3));
}

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(3, 7, 18, 0.8);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 100;
  padding: 1.25rem;
  opacity: 0;
  transition: opacity 0.25s ease;
}
.modal-overlay.open {
  display: flex;
  opacity: 1;
}
.modal-dialog {
  background: #111827;
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 16px;
  width: 100%;
  max-width: 620px;
  max-height: 90vh;
  overflow-y: auto;
  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7);
  transform: scale(0.96);
  transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.modal-overlay.open .modal-dialog {
  transform: scale(1);
}
.modal-dialog.wide {
  max-width: 1080px;
}
.modal-header {
  padding: 1.35rem 1.75rem;
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(17, 24, 39, 0.95);
}
.modal-header h3 {
  margin: 0;
  font-size: 1.15rem;
  font-weight: 700;
  color: #ffffff;
}
.modal-close {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid var(--border);
  color: var(--text-muted);
  width: 32px;
  height: 32px;
  border-radius: 8px;
  font-size: 1.2rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.15s ease;
}
.modal-close:hover { background: rgba(255, 255, 255, 0.1); color: #ffffff; }
.modal-body {
  padding: 1.75rem;
}
.modal-footer {
  padding: 1.25rem 1.75rem;
  border-top: 1px solid var(--border);
  display: flex;
  justify-content: flex-end;
  gap: 0.85rem;
  background: #0d131f;
  border-radius: 0 0 16px 16px;
}

.preview-input {
  background: rgba(11, 15, 23, 0.8);
  border: 1px solid var(--border);
  color: var(--text);
  padding: 0.35rem 0.5rem;
  border-radius: 6px;
  font-size: 0.78rem;
  width: 100%;
  box-sizing: border-box;
  outline: none;
}
.preview-input:focus {
  border-color: #6366f1;
  box-shadow: 0 0 0 1px #6366f1;
}

.grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.15rem;
}
@media (max-width: 640px) {
  .grid-2 {
    grid-template-columns: 1fr;
  }
}

.teams-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
  gap: 1.35rem;
}
.team-badge-tag {
  background: rgba(255, 255, 255, 0.04);
  color: #d1d5db;
  border: 1px solid var(--border);
  padding: 0.25rem 0.6rem;
  border-radius: 9999px;
  font-size: 0.72rem;
  font-weight: 500;
  display: inline-block;
  margin-right: 0.4rem;
  margin-bottom: 0.4rem;
}

.hidden { display: none !important; }
.text-muted { color: var(--text-muted); }
.text-emerald { color: #34d399; }
.text-amber { color: #fbbf24; }
.text-indigo { color: #818cf8; }

.svg-chart-container {
  width: 100%;
  height: 240px;
  display: flex;
  align-items: flex-end;
  gap: 1rem;
  padding-top: 1.5rem;
  box-sizing: border-box;
  border-bottom: 1px solid var(--border);
}
.svg-bar-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
  justify-content: flex-end;
  position: relative;
}
.svg-bar {
  width: 75%;
  max-width: 40px;
  background: linear-gradient(180deg, #6366f1 0%, #4338ca 100%);
  border-radius: 8px 8px 0 0;
  transition: height 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  min-height: 4px;
  box-shadow: 0 4px 12px rgba(99, 102, 241, 0.25);
}
.svg-bar-val {
  font-size: 0.74rem;
  color: var(--text-muted);
  margin-bottom: 0.4rem;
  font-weight: 700;
}
.svg-bar-label {
  font-size: 0.72rem;
  color: #9ca3af;
  margin-top: 0.5rem;
  white-space: nowrap;
  font-weight: 600;
}

@media print {
  body { background: #fff !important; color: #000 !important; }
  .delta-header, .tabs-nav-container, .gemini-alert, .action-bar, .filters-box, .btn-delta { display: none !important; }
  .table-card { border: none !important; box-shadow: none !important; background: #fff !important; }
  .delta-table th { background: #f3f4f6 !important; color: #111 !important; border-bottom: 2px solid #ccc !important; }
  .delta-table td { color: #111 !important; border-bottom: 1px solid #e5e7eb !important; }
}
